# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/
env/

# Local data and output. The digest archive is the one exception: it is the
# durable record of what actually went out, it feeds storyline threading across
# days, and CI commits it back after each send (see .github/workflows/daily.yml).
data/*
!data/digest_archive.jsonl
out/
*.sqlite
*.sqlite3
*.db

# Secrets and env files
.env
.env.local
*.local

# IDE
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Playwright MCP scratch captures (one-off page snapshots from deriving selectors)
.playwright-mcp/

# Local reference materials (copyrighted PDFs, sample emails, etc.)
*.pdf
